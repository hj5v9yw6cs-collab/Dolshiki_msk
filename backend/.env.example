# Токен админских эндпоинтов (правка юридического конфига, список заявок).
# Обязателен: без него админские ручки отключены.
ADMIN_TOKEN=смените-на-длинную-случайную-строку

# БД. По умолчанию SQLite в backend/data/app.db.
# Для боевого контура — PostgreSQL на сервере в РФ:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dolshiki
DATABASE_URL=

# Домены, которым разрешено обращаться к API (виджет на сайте).
CORS_ORIGINS=https://garantlc.ru,https://www.garantlc.ru

# Уведомления о новых заявках в Telegram (необязательно).
# Заявка сохраняется в базу в любом случае.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

LOG_LEVEL=INFO
